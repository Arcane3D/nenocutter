{
  "name": "nenocutter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Nenocutter is a browser-based cookie cutter designer. Draw, trace, preview, and export printable STL, 3MF, OBJ, and PDF files for free.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@supabase/supabase-js": "^2.119.0",
    "@visioncortex/vtracer": "1.0.0-alpha.4",
    "fflate": "^0.8.2",
    "idb": "^8.0.3",
    "imagetracerjs": "^1.2.6",
    "jspdf": "^4.2.1",
    "manifold-3d": "^3.5.4",
    "opentype.js": "^1.3.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.15.0",
    "three": "^0.187.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
